@startuml
' Настройка стиля отображения
hide circle
skinparam linetype ortho
skinparam monochrome false
skinparam shadowing false

entity "Movies" as movies {
  * **movie_id** : int (PK)
  --
  title : str
  genre : str
  duration : int
  age_rating : str
}

entity "Halls" as halls {
  * **hall_id** : int (PK)
  --
  name : str
  rows_count : int
  seats_per_row : int
}

entity "User" as user {
  * **user_id** : int (PK)
  --
  username : str
  password_hash : str
  role : str
}

entity "Sessions" as sessions {
  * **session_id** : int (PK)
  --
  * **movie_id** : int (FK)
  * **hall_id** : int (FK)
  date_time : str
}

entity "Tickets" as tickets {
  * **ticket_id** : int (PK)
  --
  * **session_id** : int (FK)
  * **user_id** : int (FK)
  ticket_price : int
  row_number : int
  seat_number : int
  payment_status : bool
}

' Определение связей "Один ко Многим" (1:N)
movies ||--|{ sessions
halls  ||--|{ sessions
user   ||--|{ tickets
sessions ||--|{ tickets

@enduml
